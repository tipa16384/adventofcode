--[[pod_format="raw",created="2025-12-01 00:13:48",modified="2025-12-12 04:27:04",revision=746]]

input_lines = nil
log = {}
max_lines_to_display = 19
line_height = 10
frame_count = 0
current_line = 0
part1_value = 0
part2_value = 0
first_log_line = -1
part1_solver = nil
part2_solver = nil

big_sprite = {
	flip=false,
	offsets={ {0,0}, {16,0}, {0,16}, {16,16} },
	sprite_sheet = nil,
	jump_start = -1
}

sam_the_cat = nil
the_safe = nil
the_ground = nil

function _init()
	local content = fetch("input.txt")
	if content then
		add_to_log("File found!")
		input_lines = read_input_strings(content)
		add_to_log("Read " .. #input_lines .. " lines of input.")
	else
		add_to_log("Nope, no luck.")
		input_lines = {}
	end

	big_sprite.sprite_sheet = fetch("./gfx/cats.gfx")
	if big_sprite.sprite_sheet then
		add_to_log("Cats meowing!")
	else
		add_to_log("Warning: Cats not found.")
	end	
	add_to_log("")
	
	sam_the_cat = big_sprite:new(230, 210)
	sam_the_cat.flip = true
	function sam_the_cat:get_sprite_list()
		local anim = { 0, 1, 6, 7 }
		if (frame_count & 16) == 0 then
			anim = { 2, 3, 8, 9 }
		end
		return anim
	end
	
	function sam_the_cat:get_position()
		return { self.position[1], self.position[2] + 2 * jump_offset(self.jump_start) }
	end
	
	the_safe = big_sprite:new(265, 210)
	function the_safe:get_sprite_list()
		return { 28, 29, 30, 31 }
	end
	
	function the_safe:get_position()
		return { self.position[1], self.position[2] + jump_offset(self.jump_start) }
	end
	
	the_ground = big_sprite:new(0,242)
	function the_ground:get_sprite_list()
		return { 24, 25, 26, 27 }
	end	
	
	part1_solver = coroutine.create(part1)
	part2_solver = coroutine.create(part2)
end

function _draw()
	local base_x = 25
	local base_y = 0

	cls(28)
	spr(63, 0, 0)
	map()

	-- cache #log and first index
	local log_count   = #log
	local first_index = max(1, log_count - max_lines_to_display + 1)
	
	if first_log_line > 0 then
		first_index = first_log_line
	end
	
	local last_index = min(log_count, first_index + max_lines_to_display - 1)

	-- starting y for log entries
	local start_y = base_y + 24

	for i = first_index, last_index do
		-- avoid recomputing top_x + offset every time
		local y = start_y + (i - first_index) * line_height
		print(log[i], base_x, y, 12)
	end
	
	lcd_string("PART 1", 256, 40)
	lcd_string(string.format("%016d", part1_value), 256, 60)
	lcd_string("PART 2", 256, 100)
	lcd_string(string.format("%016d", part2_value), 256, 120)
	
	lcd_string("ADV3NT 0F C0D3", 265, 150)
	lcd_string("2025 D4Y I1", 265, 170)
	
	draw_cat(sam_the_cat)
	draw_cat(the_safe)
	
	for i = 0,500,32 do
		the_ground.position[1] = i
		draw_cat(the_ground)
	end
end

function _update()
	frame_count = frame_count + 1

	if btnp(0) then
		sam_the_cat.flip = true
	elseif btnp(1) then
		sam_the_cat.flip = false
	end

	if sam_the_cat.jump_start < 0 and btnp(4) then
		sam_the_cat.jump_start = frame_count
	elseif sam_the_cat.jump_start >= 0 and frame_count > sam_the_cat.jump_start + 15 then
		sam_the_cat.jump_start = -1
	end	

	if the_safe.jump_start < 0 and btnp(5) then
		the_safe.jump_start = frame_count
	elseif the_safe.jump_start >= 0 and frame_count > the_safe.jump_start + 15 then
		the_safe.jump_start = -1
	end
	
	if btnp(2) then
		if first_log_line <= 0 then
			first_log_line = max(1, #log - max_lines_to_display)
		else
			first_log_line = max(1, first_log_line-1)
		end
	end
	
	if btnp(3) and first_log_line > 0 then
		first_log_line = max(1, min(first_log_line + 1, #log - max_lines_to_display + 1))
	end

	if part2_solver then
		local ok, x = coroutine.resume(part2_solver, input_lines)
		if not ok then
			add_to_log("PART 2 SOLVE ERROR! " .. x)
		elseif x < 0 then
			part2_solver = nil
			add_to_log("PART 2 COMPLETE")
		end
	end

	if frame_count % 1 == 0 and current_line >= 0 then
		if current_line < #input_lines then
			current_line = current_line + 1
			local ok, err = coroutine.resume(part1_solver, "read", input_lines[current_line])
			if not ok then
				add_to_log("PART 1 READ ERROR! " .. err)
			end
		else
			local ok, x = coroutine.resume(part1_solver, "solve", nil)
			if not ok then
				add_to_log("PART 1 SOLVE ERROR! " .. x)
				current_line = -1
			elseif x == nil or x < 0 then
				current_line = -1
				add_to_log("Exiting")
			end
		end
	end
end

-- Count paths in a DAG from start_node to end_node.
-- graph: table<string, table<int, string>>
--        e.g. graph["A"] = {"B", "C"}
-- start_node, end_node: strings
local function count_paths(graph, start_node, end_node)
    -- 1. Collect all nodes (keys + all destinations)
    local nodes = {}        -- array of node names
    local node_set = {}     -- set-like lookup

    -- Add all keys
    for u, _ in pairs(graph) do
        if not node_set[u] then
            node_set[u] = true
            nodes[#nodes + 1] = u
        end
    end

    -- Add all destinations
    for u, edges in pairs(graph) do
        for _, v in ipairs(edges) do
            if not node_set[v] then
                node_set[v] = true
                nodes[#nodes + 1] = v
            end
        end
    end

    -- Ensure start and end exist even if isolated
    if start_node and not node_set[start_node] then
        node_set[start_node] = true
        nodes[#nodes + 1] = start_node
    end
    if end_node and not node_set[end_node] then
        node_set[end_node] = true
        nodes[#nodes + 1] = end_node
    end

    -- 2. Compute in-degrees
    local indegree = {}
    for _, node in ipairs(nodes) do
        indegree[node] = 0
    end

    for u, edges in pairs(graph) do
        for _, v in ipairs(edges) do
            indegree[v] = (indegree[v] or 0) + 1
        end
    end

    -- 3. Kahn's algorithm for topological order
    local queue = {}
    local head, tail = 1, 0

    for _, node in ipairs(nodes) do
        if indegree[node] == 0 then
            tail = tail + 1
            queue[tail] = node
        end
    end

    local topo = {}
    while head <= tail do
        local u = queue[head]; head = head + 1
        topo[#topo + 1] = u

        local edges = graph[u]
        if edges then
            for _, v in ipairs(edges) do
                local d = indegree[v] - 1
                indegree[v] = d
                if d == 0 then
                    tail = tail + 1
                    queue[tail] = v
                end
            end
        end
    end

    -- Optional: verify DAG
    if #topo ~= #nodes then
        error("Graph contains a cycle; not a DAG.")
    end

    -- 4. DP: ways[node] = number of paths node -> end_node
    local ways = {}
    for _, node in ipairs(nodes) do
        ways[node] = 0
    end
    ways[end_node] = 1

    -- 5. Process nodes in reverse topological order
    for i = #topo, 1, -1 do
        local u = topo[i]
        if u ~= end_node then
            local sum = 0
            local edges = graph[u]
            if edges then
                for _, v in ipairs(edges) do
                    sum = sum + (ways[v] or 0)
                end
            end
            ways[u] = sum
        end
    end

    return ways[start_node] or 0
end

-- solver for part 1
function part1(state, input)
	local tree = {}
	while state == "read" do
		local parts = split_ws(input)
		local key = parts[1]
		key = key:sub(1, #key-1)
		local branches = {}
		for i = 2, #parts do
			table.insert(branches, parts[i])
		end
		tree[key] = branches
		add_to_log(string.format("Added node %s", key))
		state, input = coroutine.yield(1)
	end
	
	add_to_log("Calculating Part 1...")
	coroutine.yield(1)
	part1_value = count_paths(tree, "you", "out")
	
	add_to_log("Calculating Part 2a...")
	coroutine.yield(1)
	part2_value = count_paths(tree, "svr", "fft")
	add_to_log("Calculating Part 2b...")
	coroutine.yield(1)
	part2_value = part2_value * count_paths(tree, "fft", "dac")
	add_to_log("Calculating Part 2c...")
	coroutine.yield(1)
	part2_value = part2_value * count_paths(tree, "dac", "out")
	add_to_log("Calculating Part 2d...")
	coroutine.yield(1)
	local next_bit = count_paths(tree, "svr", "dac")
	add_to_log("Calculating Part 2e...")
	coroutine.yield(1)
	next_bit = next_bit * count_paths(tree, "dac", "fft")
	add_to_log("Calculating Part 2f...")
	coroutine.yield(1)
	next_bit = next_bit * count_paths(tree, "fft", "out")
	part2_value = part2_value + next_bit
	coroutine.yield(-1)
end

function part2(input)
	coroutine.yield(-1)
end

function find_all_char(s, ch)
	local idxs = {}
	local pos = 1
	while true do
		local i = string.find(s, ch, pos, true)  -- literal search
		if not i then break end
		table.insert(idxs, i)
		pos = i + 1
	end
	return idxs
end

function tmap(tab, fn)
	local out = {}
	for i, v in ipairs(tab) do
		out[i] = fn(v)
	end
	return out
end

function reduce(t, fn, init)
	local acc = init
	local start = 1

	-- if no initial value, use t[1] and start at element 2
	if acc == nil then
		acc = t[1]
		start = 2
	end

	for i = start, #t do
		acc = fn(acc, t[i], i)
	end

	return acc
end

-- return the maximum n digits in s
function max_digit_except(s, n)
	local digits, start, index, digit = "", 1, -1, 0
	for i = 1, n do
		local s1 = string.sub(s,start,#s-(n-i))
		digit, index = max_digit(s1)
		digits = digits .. tostring(digit)
		start = start + index
	end
	return tonumber(digits)
end

-- find the max digit in "s" and return it and its index
function max_digit(s)
	local value, index = -1, -1
	for i = 1, #s do
		local d = tonumber(string.sub(s, i, i))
		if d > value then
			value = d
			index = i
		end
	end
	return value, index
end

-- number of digits in the number or string "n"
function digits(n)
    return #tostring(n)
end

function split_ws(s)
    local t = {}
    for w in s:gmatch("%S+") do
        t[#t+1] = w
    end
    return t
end


-- split a string "s" at "c" and return a table of results
function split_char(s, c)
    local result = {}
    local pattern = "([^" .. c .. "]+)"
    for part in s:gmatch(pattern) do
        table.insert(result, part)
    end
    return result
end

-- return true if the number of characters in "s" is odd
function is_odd_length(s)
	return #s % 2 == 1
end

function is_odd(n)
	return (n & 1) == 1
end

function jump_offset(state)
	if state < 0 then
		return 0
	end
	local t = frame_count - state
   return (16/45) * t * (t - 15)
end

function lcd_string(s, x, y)
	local sprite_width = 9
	local byte_0 = string.byte("0")
	local byte_9 = string.byte("9")
	local byte_a = string.byte("A")
	local byte_z = string.byte("Z")
	local num_base = 8
	local alpha_base = 18
	
	for i = 1, #s do
		local char = string.byte(s, i)
		local sprite = nil
		if char >= byte_0 and char <= byte_9 then
			sprite = num_base + char - byte_0
		elseif char >= byte_a and char <= byte_z then
			sprite = alpha_base + char - byte_a
		end
		if sprite then
			local dx = sprite_width * (i - 1)
			spr(sprite, x + dx, y)
		end
	end
end

function read_input_numbers()
	numbers = {}
	for line in data:gmatch("[^\r\n]+") do
   	 numbers[#numbers+1] = tonumber(line)
	end    
   
   return numbers
end

function read_input_strings(source)
	local strings = {}
	local pos = 1
	
	while true do
		local b, e = string.find(source, "\n", pos, true)
		if not b then
			table.insert(strings, source:sub(pos))  -- last line
			break
		end
		table.insert(strings, source:sub(pos, b - 1))
		pos = e + 1
	end

   return strings
end

function add_to_log(string)
	log[#log+1] = string
end

function draw_cat(which_cat)
	local sprites = which_cat:get_sprite_list()
	local offsets = which_cat.offsets
	local cat_sheet = which_cat.sprite_sheet
	local flip = which_cat.flip
	local position = which_cat:get_position()
	
	if flip then
		offsets = { offsets[2], offsets[1], offsets[4], offsets[3] }
	end
	
	palt(30, true)
	for i = 1, 4 do
		spr(cat_sheet[sprites[i]].bmp,
			position[1] + offsets[i][1],
			position[2] + offsets[i][2],
			flip)
	end
	palt()
end

function big_sprite:new(x,y)
	return setmetatable({ position={x,y} }, {__index=self})
end

function big_sprite:get_sprite_list()
	return {0,0,0,0}
end

function big_sprite:get_position()
	return self.position
end

function sort(arr, comp)
	local insertion_sort, quick_sort
	if comp then
	 	insertion_sort = function (min,max)
			for i = min+1,max do
				for j = i,min+1,-1 do
					local item,other = arr[j],arr[j-1]
					if comp(other, item) then break end
					arr[j],arr[j-1] = other,item
				end
			end
		end

		quick_sort = function (min,max)
			if min >= max then
				return
			end

			local pivot
			local pivot_i = math.floor((max+min)/2)
			pivot = arr[pivot_i]

			local first = arr[min]
			local last = arr[max]

			if comp(pivot, first) then
				arr[min],arr[pivot_i] = arr[pivot_i],arr[min]
				first,pivot = pivot,first
			end
			if comp(last, pivot) then
				arr[pivot_i],arr[max] = arr[max],arr[pivot_i]
				pivot = last
			end
			if comp(pivot, first) then
				arr[min],arr[pivot_i] = arr[pivot_i],arr[min]
				pivot = first
			end

			if max-min < 3 then return end

			local low,high = min+1,max-1
			while true do
				while low < high and comp(arr[low], pivot) do
					low = low + 1
				end
				while low < high and comp(pivot, arr[high]) do
					high = high - 1
				end
				if low >= high then break end

				arr[low],arr[high] = arr[high],arr[low]
				low = low + 1
				high = high - 1
			end

			local algo = high-min < 8 and insertion_sort or quick_sort
			algo(min,high)
			algo = max-low < 8 and insertion_sort or quick_sort
			algo(low,max)
		end
	else
	 	insertion_sort = function (min,max)
			for i = min+1,max do
				for j = i,min+1,-1 do
					local item,other = arr[j],arr[j-1]
					if other < item then break end
					arr[j],arr[j-1] = other,item
				end
			end
		end

		quick_sort = function (min,max)
			if min >= max then
				return
			end

			local pivot
			local pivot_i = math.floor((max+min)/2)
			pivot = arr[pivot_i]

			local first = arr[min]
			local last = arr[max]

			if first >= pivot then
				arr[min],arr[pivot_i] = arr[pivot_i],arr[min]
				first,pivot = pivot,first
			end
			if pivot >= last then
				arr[pivot_i],arr[max] = arr[max],arr[pivot_i]
				pivot = last
			end
			if first >= pivot then
				arr[min],arr[pivot_i] = arr[pivot_i],arr[min]
				pivot = first
			end

			if max-min < 3 then return end

			local low,high = min+1,max-1
			while true do
				while low < high and arr[low] < pivot do
					low = low + 1
				end
				while low < high and arr[high] >= pivot do
					high = high - 1
				end
				if low >= high then break end

				arr[low],arr[high] = arr[high],arr[low]
				low = low + 1
				high = high - 1
			end

			local algo = high-min < 8 and insertion_sort or quick_sort
			algo(min,high)
			algo = max-low < 8 and insertion_sort or quick_sort
			algo(low,max)
		end
	end
	local algo = #arr <= 8 and insertion_sort or quick_sort
	algo(1, #arr)
end

function is_blank(s)
    return s:match("^%s*$") ~= nil
end

PriorityQueue = {}
PriorityQueue.__index = PriorityQueue

function PriorityQueue.new()
    return setmetatable({heap = {}}, PriorityQueue)
end

local function parent(i) return math.floor(i / 2) end
local function left(i)   return 2 * i end
local function right(i)  return 2 * i + 1 end

-- Swap helper
local function swap(h, a, b)
    h[a], h[b] = h[b], h[a]
end

function PriorityQueue:push(priority, value)
    local h = self.heap
    local i = #h + 1
    h[i] = {priority = priority, value = value}

    -- bubble up
    while i > 1 do
        local p = parent(i)
        if h[p].priority <= h[i].priority then break end
        swap(h, p, i)
        i = p
    end
end

function PriorityQueue:pop()
    local h = self.heap
    local n = #h
    if n == 0 then return nil end

    swap(h, 1, n)
    local item = h[n]
    h[n] = nil
    n = n - 1

    -- bubble down
    local i = 1
    while true do
        local l, r = left(i), right(i)
        local smallest = i

        if l <= n and h[l].priority < h[smallest].priority then
            smallest = l
        end
        if r <= n and h[r].priority < h[smallest].priority then
            smallest = r
        end
        if smallest == i then break end
        swap(h, i, smallest)
        i = smallest
    end

    return item.priority, item.value
end

function PriorityQueue:peek()
    local h = self.heap
    if #h == 0 then return nil end
    return h[1].priority, h[1].value
end

function PriorityQueue:is_empty()
    return #self.heap == 0
end

